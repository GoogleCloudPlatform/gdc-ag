# ==============================================================================
# GDC-SANDBOX ENVIRONMENT CONFIGURATION (.env.gdc)
# ==============================================================================
# Copy this file to .env in your execution directory when targeting GDC-Sandbox:
#   cp .env.gdc.example .env
# Or pass directly to bootstrap scripts via -e / --env-file:
#   python3 scripts/bootstrap/bootstrap.py -e .env.gdc

# Target Platform Selector (gcp | gdc)
TARGET_PLATFORM=gdc


# ==============================================================================
# SECTION 1: REQUIRED TO GET STARTED (Cluster & Kubernetes Access)
# ==============================================================================
# Target standard cluster name defined in manifests/gdc_cluster/ (cluster.gdc.goog/v1)
CLUSTER_NAME=gitops-platform1

# GDC Management Project and Kubeconfig (for cluster resource creation on management plane)
GDC_PROJECT_ID=project-lowhigh
GDC_MANAGEMENT_KUBECONFIG=/home/sandboxuser10/org-1-admin-kubeconfig

# Path to the GDC standard cluster KUBECONFIG file for cluster administration
KUBECONFIG=/home/sandboxuser10/gitops-platform1-kubeconfig

# Email / identity of the workshop operator / platform administrator
PLATFORM_ADMIN="platform-admin@example.com"


# ==============================================================================
# SECTION 2: AIR-GAPPED CONTAINER REGISTRY (Harbor)
# ==============================================================================
# Internal Harbor registry host and project path
HARBOR_INSTANCE=user-haas-instance
HARBOR_INSTANCE_PROJECT=user-project
HARBOR_URL=user-haas-instance-user-project.org-1.zone1.google.gdch.test
HARBOR_PROJECT=project-lowhigh

# Robot account credentials for pulling/pushing images via Docker & K8s secrets
HARBOR_USERNAME='robot$project-lowhigh+harborbot'
HARBOR_PASSWORD=[ROBOT_ACCOUNT_SECRET]

# Name of the Kubernetes secret holding Harbor pull credentials
IMAGE_PULL_SECRET_NAME=harbor-secret


# ==============================================================================
# SECTION 3: USER AUTHENTICATION (Internal GDC OIDC / Local Auth)
# ==============================================================================
# Auth Mode: "oidc"   (GDC internal fake-oidc-provider with oidc-token-proxy)
#            "native" (Built-in ArgoCD admin and GitLab root accounts)
AUTH_MODE=oidc

# GDC Internal OIDC Provider configuration for ArgoCD Dex & GitLab OmniAuth
GDC_OIDC_ISSUER=https://fake-oidc-provider.org-1.zone1.google.gdch.test
GDC_OIDC_CLIENT_ID=gpc
GDC_OIDC_CLIENT_SECRET=very-private-oidc-client-secret
GDC_OIDC_UPSTREAM_IP=10.200.20.4


# ==============================================================================
# SECTION 4: LOCAL ENDPOINTS & PORT-FORWARDS
# ==============================================================================
# Local port-forward endpoints for accessing web UIs and CLI integrations
ARGOCD_SERVER_URL=https://localhost:8088
GITLAB_HTTP_URL=http://localhost:8081

