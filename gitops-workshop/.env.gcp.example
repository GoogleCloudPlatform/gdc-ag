# ==============================================================================
# SECTION 1: REQUIRED TO GET STARTED (Day-0 Bootstrap)
# ==============================================================================
# These settings must be configured before running any bootstrap scripts.

# Target Platform Selector (gcp | gdc)
TARGET_PLATFORM=gcp

# Target GCP Project ID (auto-created and linked to billing if non-existent)
GCP_PROJECT=gitops-workshop-demo

# GCP Billing Account ID (Optional: if omitted and project is created, prompts interactively)
# GCP_BILLING_ACCOUNT=012345-6789AB-CDEF01

# Email of the workshop participant / administrator (assigned Project Owner, ArgoCD Admin, GitLab Owner)
GCP_PROJECT_OWNER=user@example.com

# Target Google Cloud Region for GKE and networking
GCP_REGION=us-central1


# ==============================================================================
# SECTION 2: REQUIRED LATER FOR USER AUTHENTICATION (Phases 3 & 4)
# ==============================================================================
# Google Cloud OAuth 2.0 Web Application credentials for Dex (ArgoCD) and OmniAuth (GitLab).
# You can leave these commented out initially and populate them before running Phase 3/4.
# Redirect URIs required in GCP Console:
#   - http://localhost:8080/api/dex/callback
#   - http://localhost:8081/users/auth/google_oauth2/callback

# GCP_OIDC_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GCP_OIDC_CLIENT_SECRET=GOCSPX-your-client-secret


# ==============================================================================
# SECTION 3: ADVANCED CONFIGURATION & OVERRIDES (Optional)
# ==============================================================================
# Standard defaults are provided below. Participants do not need to modify these
# for a basic run-through.

# Name of the GKE Autopilot cluster
GKE_CLUSTER_NAME=gitops-demo-cluster

# Local port-forward endpoints for accessing web UIs and CLI integrations
ARGOCD_SERVER_URL=http://localhost:8080
GITLAB_HTTP_URL=http://localhost:8081

# Custom VPC Network name override.
# Defaults dynamically to <GKE_CLUSTER_NAME>-vpc (1 VPC per cluster isolation).
# GCP_VPC_NETWORK_OVERRIDE=custom-vpc-name

# Custom GitLab Admin Credentials.
# By default, secure random credentials are generated dynamically on the fly and output to the console.
# Uncomment only if you wish to enforce custom static credentials.
# GITLAB_ROOT_PASSWORD_OVERRIDE=YourCustomRootPassword123!
# GITLAB_ROOT_TOKEN_OVERRIDE=glpat-YourCustomRootToken123
