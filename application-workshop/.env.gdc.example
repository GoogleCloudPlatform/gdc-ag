# ==============================================================================
# GitOps Application Workshop Configuration (Google Distributed Cloud Sandbox)
# Copy this file to .env before running scripts:
#   cp .env.gdc.example .env
# ==============================================================================

# 1. Target Platform ("gcp" | "gdc")
TARGET_PLATFORM="gdc"

# 2. Target GitLab Project Repository (Provisioned in gitops-workshop)
# Set to the <group>/<project> repository created via provision_project.py
GITLAB_GROUP="workloads"
GITLAB_PROJECT="translate-project"

# 3. Default Application & Image Tag ("translate-api" | "upload-api")
# Can also be passed per command via: -a translate-api or -a upload-api
APP_NAME="translate-api"
APP_IMAGE_TAG="v1.0.0"

# 4. GDC Standard Cluster Target
CLUSTER_NAME="gitops-platform1"
# Optional: Explicit KUBECONFIG path (defaults to active KUBECONFIG or ~/.kube/gdc-${CLUSTER_NAME}.kubeconfig)
# KUBECONFIG="/home/sandboxuser10/gitops-platform1-kubeconfig"

# 5. GDC Harbor Registry (High-Side Container Registry)
# Leave HARBOR_URL empty to auto-discover via gdcloud, or set to your Harbor endpoint
HARBOR_INSTANCE_NAME="gitops-registry"
HARBOR_PROJECT="gitops-platform"
HARBOR_URL=""
HARBOR_USERNAME="admin"
HARBOR_PASSWORD=""

# 6. GitOps Platform Endpoints (via kubectl port-forward)
ARGOCD_SERVER_URL="http://localhost:8088"
GITLAB_HTTP_URL="http://localhost:8081"

# 7. Application Runtime Configuration
# translate-api settings:
TRANSLATE_APP_API_KEY="sample-key-12345"
KEYCLOAK_URL="http://keycloak:8080"
KEYCLOAK_REALM="sandbox"
# upload-api optional S3 / GDC Object Storage settings:
UPLOAD_BUCKET_NAME="upload-api-archives"
UPLOAD_STORAGE_ENDPOINT="https://objectstorage.org-1.zone1.google.gdch.test"
UPLOAD_ACCESS_KEY_ID=""
UPLOAD_SECRET_ACCESS_KEY=""

# 8. GDC Identity Personas (OIDC Provider)
GDC_ORG_ADMIN_USER="infrastructure-operator@example.com"
GDC_APP_OPERATOR_USER="application-operator@example.com"
GDC_PLATFORM_ADMIN_USER="platform-admin@example.com"

# 9. Optional GitLab Root Credentials Override
# Leave empty to automatically retrieve from the cluster's gitlab-oauth-secret
GITLAB_ROOT_PASSWORD=""
GITLAB_ROOT_TOKEN=""
